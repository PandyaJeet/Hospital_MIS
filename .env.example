# =============================================================================
# Hospital MIS — environment variable reference
#
# Copy to `.env` (repo root, gitignored) and fill in real values from the
# Supabase dashboard. This file is committed and must NEVER contain real values.
#
#   cp .env.example .env
#
# Next.js note (apps/web): only variables prefixed NEXT_PUBLIC_ are exposed to
# the browser. Anything without that prefix stays server-side. Getting this wrong
# is how service-role keys leak, so the prefix is not cosmetic.
# =============================================================================


# -----------------------------------------------------------------------------
# PUBLIC — safe to ship to the browser
# -----------------------------------------------------------------------------

# Base project URL. No trailing slash, and NO /rest/v1 suffix — the Supabase
# client appends its own paths. Copy from: Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable ("anon") key — newer projects issue `sb_publishable_...`, older ones
# a long `eyJ...` JWT. Either works. This key is *designed* to be public: it
# carries no authority of its own, and every request it makes is still filtered
# by Row-Level Security based on the signed-in user.
# Copy from: Project Settings > API Keys > publishable / anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# SERVER-ONLY — never expose, never prefix with NEXT_PUBLIC_
# -----------------------------------------------------------------------------

# Secret ("service_role") key — newer projects issue `sb_secret_...`.
#
#   !! THIS KEY BYPASSES ROW-LEVEL SECURITY ENTIRELY. !!
#
# With it, tenant isolation does not apply: every clinic's data is readable and
# writable. Treat it like a production database password.
#
#   - Never import it into anything under apps/web that runs in the browser
#   - Never commit it (rules.md §1.4)
#   - Never paste it into a migration, seed file, or log line
#   - In production it belongs in Vercel/Supabase project settings, not a file
#
# In this repo it is used by exactly one thing: supabase/scripts/seed.ts, which
# needs the Auth Admin API to create the dummy dev users. If you find yourself
# reaching for it anywhere else, that is a design smell — the answer is almost
# always an RLS policy or a SECURITY DEFINER function instead (rules.md §1.1).
#
# Copy from: Project Settings > API Keys > secret / service_role key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Project ref — the subdomain of NEXT_PUBLIC_SUPABASE_URL.
# Used by `npm run db:link`.
SUPABASE_PROJECT_REF=your-project-ref


# -----------------------------------------------------------------------------
# LOCAL DEV TOOLING — needed to apply migrations and seed test data
# -----------------------------------------------------------------------------

# Personal access token (`sbp_...`) for the Supabase CLI.
#
# NOTE: this is NOT the same thing as the secret key above. The secret key
# authorises *data* access to one project; a personal access token authorises
# *management* operations (schema changes) across your account. `supabase link`
# and `supabase db push` require this one, which is why having only the secret
# key is not enough to apply migrations.
#
# Create at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxx

# Database password, set when the project was created. An alternative to the
# access token for a direct Postgres connection. Reset at:
# Project Settings > Database > Database password
SUPABASE_DB_PASSWORD=

# Password assigned to the 8 dummy accounts created by `npm run db:seed`.
# Dev fixtures only, on a dev project — but still pick something throwaway, and
# never reuse a password you use anywhere real. The remote RLS test signs in with
# this to exercise real sessions, so it must match what the seed used.
SEED_USER_PASSWORD=choose-a-throwaway-dev-password


# -----------------------------------------------------------------------------
# FRONTEND DEV FLAGS (apps/web — Prince's track)
# -----------------------------------------------------------------------------

# Contract-first mock switch (Workflow.md §3). `true` makes the data layer return
# fixtures shaped per docs/contracts/*.md, so UI work never blocks on the backend.
# Must stay `true` until the migrations are applied to the project.
NEXT_PUBLIC_USE_MOCK=true
