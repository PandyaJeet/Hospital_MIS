# Frontend environment variables (apps/web).
#
# Copy this file to `apps/web/.env.local` and fill in the real values.
# `.env.local` is gitignored — never commit real keys.
#
# Why a second env file: Next.js only loads env files from the app directory, so
# the repo-root `.env` (used by the Supabase CLI, seed scripts and test suites)
# is NOT visible to the app. The two NEXT_PUBLIC_* values below are therefore
# duplicated between root `.env` and `apps/web/.env.local`. Variable names match
# the root `.env.example` so there is only one name per value.
#
# Only NEXT_PUBLIC_-prefixed variables reach the browser. Never put the service
# role key or the DB password in this file — they are server-only and belong in
# the root `.env` (see the warnings there).

# Base project URL. No trailing slash, no /rest/v1 suffix.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable ("anon") key. Newer projects issue `sb_publishable_...`, older
# ones a long JWT; both work under this name during the transition.
# Copy from: Project Settings > API Keys > publishable / anon key.
# Safe to expose to the browser — RLS is the real security boundary.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Frontend mock switch (Workflow.md §3). "true" runs the UI against the mock
# data in lib/data/* so screens can be built without a backend; set to "false"
# to talk to the real database.
NEXT_PUBLIC_USE_MOCK=true
