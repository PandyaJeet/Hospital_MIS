# Supabase environment variables.
#
# Copy this file to `.env.local` and fill in the real values from your Supabase
# project (Project Settings > API). `.env.local` is gitignored — never commit
# real keys.

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public client key. Accepts either the legacy anon key (JWT) or the new
# publishable key (sb_publishable_...). Legacy anon keys are deprecated at the
# end of 2026, so prefer the publishable key for new projects.
# This key is safe to expose to the browser — RLS is the real security boundary.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Frontend mock-data switch (Workflow.md §3). "true" runs the UI against mock
# data before the real backend is ready; unset/false uses real data.
NEXT_PUBLIC_USE_MOCK=false
